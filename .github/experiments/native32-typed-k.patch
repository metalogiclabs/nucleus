diff --git a/tests/native32_typed_k.rs b/tests/native32_typed_k.rs
new file mode 100644
index 0000000..089762d
--- /dev/null
+++ b/tests/native32_typed_k.rs
@@ -0,0 +1,48 @@
+use std::io::Write;
+use std::path::Path;
+use std::process::{Command, Stdio};
+
+fn check(name: &str, expected: i32) {
+    let root = Path::new(env!("CARGO_MANIFEST_DIR"));
+    let flags: std::collections::HashMap<String, String> =
+        serde_json::from_slice(&std::fs::read(root.join("arena-flags.json")).unwrap()).unwrap();
+    let mut cmd = Command::new(env!("CARGO_BIN_EXE_metatron-kernel"));
+    for (key, _) in std::env::vars_os() {
+        let s = key.to_string_lossy();
+        if s.starts_with("NUCLEUS_") || s.starts_with("METATRON_") {
+            cmd.env_remove(key);
+        }
+    }
+    cmd.envs(flags).stdin(Stdio::piped()).stdout(Stdio::piped()).stderr(Stdio::piped());
+    let bytes = std::fs::read(root.join("tests/fixtures/native32-typed-k").join(format!("{name}.ndjson"))).unwrap();
+    let mut child = cmd.spawn().unwrap();
+    child.stdin.take().unwrap().write_all(&bytes).unwrap();
+    let output = child.wait_with_output().unwrap();
+    assert_eq!(output.status.code(), Some(expected), "{name}: {}", String::from_utf8_lossy(&output.stderr));
+}
+
+#[test]
+fn typed_k_reduces_at_the_matching_index() {
+    check("099_ruleK", 0);
+}
+
+#[test]
+fn typed_k_preserves_dependent_function_eta() {
+    check("129_etaRuleK", 0);
+}
+
+#[test]
+fn indexed_identity_iota_uses_the_source_minor() {
+    check("indexed-iota-good", 0);
+    check("indexed-iota-bad", 2);
+}
+
+#[test]
+fn typed_k_wrong_index_and_withdrawn_authority_decline() {
+    // This Eq family needs K to justify its declared large elimination.
+    check("withdraw-k", 1);
+    for name in ["100_ruleKbad", "wrong-index-count", "forged-rule", "missing-rule",
+                 "partial-wrong-index", "partial-untyped-minor"] {
+        check(name, 2);
+    }
+}
